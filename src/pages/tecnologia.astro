---
import Base from '../layouts/Base.astro';

const capabilities = [
  ['Memoria privada de IA', 'Private AI memory'],
  ['Agentes supervisados', 'Supervised agents'],
  ['Operaciones por WhatsApp', 'WhatsApp operations'],
  ['Enrutamiento a modelos locales', 'Local model routing'],
  ['Infraestructura de campo', 'Field infrastructure'],
  ['Evidencia y trazabilidad', 'Evidence and audit trails'],
];
---
<Base title="Technology / Tecnología" description="Reusable technical capabilities and operational connectors.">
  <section class="hero">
    <span class="eyebrow" data-es="Tecnología" data-en="Technology">Technology</span>
    <h1 data-es="Capas reutilizables, no scripts sueltos." data-en="Reusable layers, not isolated scripts.">Reusable layers, not isolated scripts.</h1>
    <p data-es="Cada conector, agente o herramienta se publica una vez y después se recupera mediante MCP, la web y los paneles internos." data-en="Each connector, agent, or tool is published once and then retrieved through MCP, the website, and internal dashboards.">Each connector, agent, or tool is published once and then retrieved through MCP, the website, and internal dashboards.</p>
  </section>
  <div class="grid cols-3">
    {capabilities.map(([es, en]) => (
      <article class="card stack">
        <h2 data-es={es} data-en={en}>{en}</h2>
        <p data-es="Lista para reutilizar en paneles, coordinación y automatización." data-en="Ready to reuse across dashboards, coordination, and automation.">Ready to reuse across dashboards, coordination, and automation.</p>
      </article>
    ))}
  </div>
</Base>
