---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Contact / Contacto" description="Official contact channels and operations.">
  <section class="hero">
    <span class="eyebrow" data-es="Contacto" data-en="Contact">Contact</span>
    <h1 data-es="Hablemos." data-en="Let’s talk.">Let’s talk.</h1>
    <p data-es="Conversa con nuestro equipo sobre soporte técnico empresarial, integraciones de IA o nuevos proyectos." data-en="Talk with our team about enterprise technical support, AI integrations, or new projects.">Talk with our team about enterprise technical support, AI integrations, or new projects.</p>
  </section>
  <div class="grid cols-2">
    <section class="section stack">
      <h2 data-es="Canal central" data-en="Central channel">Central channel</h2>
      <p data-es="Para automatizaciones con IA, soporte modular o proyectos activos:" data-en="For AI automation, modular support, or active projects:">For AI automation, modular support, or active projects:</p>
      <div class="card">
        <strong data-es="Correo principal" data-en="Primary email">Primary email</strong>
        <p><a href={`mailto:${site.contact}`}>{site.contact}</a></p>
      </div>
    </section>
    <section class="section stack">
      <h2 data-es="Presencia y operaciones" data-en="Presence and operations">Presence and operations</h2>
      <div class="card"><strong>InnerChispa LLC · USA</strong><p data-es="Estrategia, arquitectura modular de IA y soluciones en la nube." data-en="Strategy, modular AI architecture, and cloud solutions.">Strategy, modular AI architecture, and cloud solutions.</p></div>
      <div class="card"><strong>PC Doctor S.A. · Ecuador</strong><p data-es="Operaciones técnicas de campo, CCTV, soporte empresarial y redes." data-en="Field operations, CCTV, enterprise support, and networking.">Field operations, CCTV, enterprise support, and networking.</p></div>
    </section>
  </div>
</Base>
