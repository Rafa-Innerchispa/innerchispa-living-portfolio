---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---
<Base title="Proyectos" description="Inventario vivo de proyectos y frentes activos.">
  <section class="hero">
    <span class="eyebrow" data-es="Proyectos" data-en="Projects" data-de="Projekte" data-fr="Projets">Proyectos</span>
    <h1 data-es="Inventario vivo del ecosistema." data-en="Live ecosystem inventory." data-de="Lebendes Ecosystem-Inventar." data-fr="Inventaire vivant de l'écosystème.">Inventario vivo del ecosistema.</h1>
    <p data-es="Base para navegar proyectos activos, paneles, hackatones y servicios compartidos sin duplicar trabajo." data-en="Base to navigate active projects, panels, hackathons, and shared services without duplicating work." data-de="Basis zur Navigation von aktiven Projekten, Panels, Hackathons und geteilten Services ohne Arbeitsduplizierung." data-fr="Base pour naviguer dans les projets actifs, les panels, les hackathons et les services partagés sans dupliquer le travail.">Base para navegar proyectos activos, paneles, hackatones y servicios compartidos sin duplicar trabajo.</p>
  </section>
  <div class="grid cols-2">
    {site.projects.map((project) => {
      const cover = project.images && project.images.length > 0 ? project.images[0].url : null;
      const coverUrl = cover ? (cover.startsWith('/') ? baseUrl + cover.slice(1) : cover) : null;
      return (
        <article class="card stack" style="overflow: hidden; padding: 0; background: var(--panel);">
          {coverUrl && (
            <div style="aspect-ratio: 3/2; overflow: hidden; border-bottom: 1px solid var(--line);">
              <img src={coverUrl} alt={project.name} style="width:100%; height:100%; object-fit:cover;" />
            </div>
          )}
          <div class="stack" style="padding: 20px;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <span class="badge" style="margin:0;">{project.status}</span>
            </div>
            <h2 style="font-size: 1.4rem; color: #fff; margin-top: 8px;">{project.name}</h2>
            <p style="font-size: 0.92rem; line-height: 1.5; color: var(--muted);">{project.summary}</p>
            
            {project.technologies && project.technologies.length > 0 && (
              <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px;">
                {project.technologies.map((tech: string) => (
                  <span class="pill" style="font-size: 0.75rem; padding: 3px 8px;">{tech}</span>
                ))}
              </div>
            )}

            <div style="margin-top: auto; padding-top: 12px; display: flex; gap: 10px;">
              {project.github_url && (
                <a href={project.github_url} target="_blank" rel="noopener noreferrer" class="pill" style="font-size:0.78rem; text-decoration:none; background:rgba(255,255,255,0.02); display: inline-flex; align-items: center; gap: 4px;">
                  💻 Código
                </a>
              )}
              {project.demo_url && (
                <a href={project.demo_url} target="_blank" rel="noopener noreferrer" class="pill" style="font-size:0.78rem; text-decoration:none; background:rgba(103, 232, 249, 0.05); border-color: var(--accent); color: var(--accent); display: inline-flex; align-items: center; gap: 4px;">
                  ⚡ Demo Live
                </a>
              )}
            </div>
          </div>
        </article>
      );
    })}
  </div>
</Base>
