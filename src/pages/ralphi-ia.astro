---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Ralphi IA (LatAm) / Ralph AI (USA)" description="Centro de coordinación MCP y automatización del ecosistema Ralphi IA / Ralph AI.">
  <section class="hero">
    <span class="eyebrow">Ralphi IA / Ralph AI</span>
    <h1>El cerebro operativo del ecosistema.</h1>
    <p>
      MCP, memoria compartida, herramientas publicadas, WhatsApp, correo, fondos, reportes y agentes.
      Todo pensado para que ChatGPT, Cursor, Codex y Antigravity trabajen sin perder contexto.
    </p>
  </section>
  <div class="grid cols-2">
    <section class="section stack">
      <h2>Flujos</h2>
      <div class="card">ChatGPT &rarr; MCP &rarr; Mongo &rarr; buzones &rarr; evidencia</div>
      <div class="card">WhatsApp &rarr; comandos, grupos, recordatorios, documentos y estados</div>
      <div class="card">Fondos &rarr; programas, solicitudes, cuentas y consumo trazable</div>
    </section>
    <section class="section stack">
      <h2>Conectores vivos</h2>
      <div class="card">OAuth + X-API-Key para compatibilidad</div>
      <div class="card">Mongo como fuente de verdad y Markdown como espejo humano</div>
      <div class="card">Local-first para ahorrar créditos externos</div>
    </section>
  </div>
</Base>
