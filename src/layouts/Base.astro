---
const { title, description } = Astro.props;
import { site } from '../data/site';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · ${site.brand}` : site.brand}</title>
    <meta name="description" content={description || site.tagline} />
    <link rel="icon" href={`${base}favicon.svg`} />
    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #0b0f14;
        --panel: #111820;
        --panel-2: #15202b;
        --line: #243244;
        --text: #ecf4ff;
        --muted: #9eb0c7;
        --accent: #67e8f9;
        --accent-2: #34d399;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; min-height: 100%; background: var(--bg); color: var(--text); font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
      a { color: inherit; text-decoration: none; }
      .shell { min-height: 100vh; display: flex; flex-direction: column; }
      .topbar, .footer, .card, .hero, .section { border: 1px solid var(--line); background: rgba(17, 24, 32, 0.94); }
      .topbar { position: sticky; top: 0; z-index: 20; backdrop-filter: blur(12px); }
      .topbar-inner, .container { width: min(1180px, calc(100% - 32px)); margin: 0 auto; }
      .topbar-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 14px 0; }
      .brand { display: flex; flex-direction: column; gap: 2px; }
      .brand strong { letter-spacing: 0.02em; }
      .nav { display: flex; flex-wrap: wrap; gap: 10px; justify-content: flex-end; }
      .nav a { padding: 8px 12px; border: 1px solid transparent; color: var(--muted); border-radius: 999px; }
      .nav a:hover { border-color: var(--line); color: var(--text); background: rgba(255,255,255,0.02); }
      main { flex: 1; }
      .container { padding: 24px 0 40px; }
      .hero { padding: 28px; border-radius: 18px; display: grid; gap: 18px; margin-bottom: 20px; }
      .hero-visual { margin: 0; padding: 0; overflow: hidden; min-height: 320px; }
      .hero-visual img { width: 100%; height: 100%; display: block; object-fit: cover; border-radius: 16px; }
      .eyebrow { color: var(--accent); font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.12em; }
      h1, h2, h3 { margin: 0; line-height: 1.1; }
      h1 { font-size: clamp(2rem, 4vw, 3.6rem); max-width: 12ch; }
      h2 { font-size: clamp(1.4rem, 2vw, 2rem); }
      p { color: var(--muted); line-height: 1.6; }
      .grid { display: grid; gap: 16px; }
      .grid.cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .grid.cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .media-grid { align-items: start; }
      .visual-card { padding: 12px; overflow: hidden; }
      .visual-card img { width: 100%; display: block; border-radius: 12px; aspect-ratio: 16 / 9; object-fit: cover; background: #0a0f16; }
      .visual-card figcaption { display: grid; gap: 8px; }
      @media (max-width: 920px) { .grid.cols-2, .grid.cols-3 { grid-template-columns: 1fr; } .topbar-inner { flex-direction: column; align-items: flex-start; } .nav { justify-content: flex-start; } }
      .card, .section { border-radius: 16px; padding: 20px; }
      .pill { display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--line); border-radius: 999px; padding: 6px 10px; color: var(--muted); font-size: 0.88rem; }
      .stack { display: flex; flex-direction: column; gap: 10px; }
      .meta { color: var(--muted); font-size: 0.92rem; }
      .badge { display: inline-flex; align-items: center; padding: 6px 10px; border-radius: 999px; background: rgba(103, 232, 249, 0.1); color: var(--accent); font-size: 0.84rem; width: fit-content; }
      .footer { padding: 18px 0; margin-top: 18px; }
      .footer .container { display: flex; justify-content: space-between; gap: 16px; align-items: center; flex-wrap: wrap; }
    </style>
  </head>
  <body>
    <div class="shell">
      <header class="topbar">
        <div class="topbar-inner">
          <div class="brand">
            <strong>{site.brand}</strong>
            <span class="meta">{site.product}</span>
          </div>
          <nav class="nav" aria-label="Principal" style="display: flex; align-items: center; gap: 12px;">
            {site.navigation.map(([label, href]) => {
              const target = href.startsWith('/') ? href.slice(1) : href;
              let es = label;
              let en = label;
              let de = label;
              let fr = label;
              if (label === 'Home') { es = 'Inicio'; de = 'Startseite'; fr = 'Accueil'; }
              else if (label === 'Proyectos') { en = 'Projects'; de = 'Projekte'; fr = 'Projets'; }
              else if (label === 'Hackatones') { en = 'Hackathons'; de = 'Hackathons'; fr = 'Hackathons'; }
              else if (label === 'Tecnología') { en = 'Technology'; de = 'Technologie'; fr = 'Technologie'; }
              else if (label === 'Contacto') { en = 'Contact'; de = 'Kontakt'; fr = 'Contact'; }
              return <a href={base + target} data-es={es} data-en={en} data-de={de} data-fr={fr}>{label}</a>;
            })}
            <select id="lang-select" style="background: var(--panel-2); color: var(--text); border: 1px solid var(--line); border-radius: 999px; padding: 6px 12px; cursor: pointer; font-size: 0.82rem; outline: none;">
              <option value="en">EN</option>
              <option value="es">ES</option>
              <option value="de">DE</option>
              <option value="fr">FR</option>
            </select>
          </nav>
        </div>
      </header>
      <main>
        <div class="container">
          <slot />
        </div>
      </main>
      <footer class="footer">
        <div class="container">
          <div>
             <strong>{site.brand}</strong>
             <div class="meta" data-es="Automatización, coordinación y entregables operativos desde un solo centro" data-en="Automation, coordination, and operational deliverables from a single hub" data-de="Automatisierung, Koordination und betriebliche Leistungen aus einer Hand" data-fr="Automatisation, coordination et livrables opérationnels à partir d'un seul hub">{site.tagline}</div>
           </div>
           <div class="stack" style="align-items: flex-end; gap: 8px;">
             <div class="meta"><span data-es="Contacto: " data-en="Contact: " data-de="Kontakt: " data-fr="Contact: ">Contacto: </span><a href={`mailto:${site.contact}`} style="color: var(--accent); text-decoration: underline;">{site.contact}</a></div>
             <div class="meta" style="display: flex; gap: 12px; margin-top: 4px;">
               <a href="https://www.linkedin.com/company/innerchispa" target="_blank" rel="noopener noreferrer" style="color: var(--muted); text-decoration: none;">LinkedIn</a>
               <a href="https://github.com/Rafa-Innerchispa" target="_blank" rel="noopener noreferrer" style="color: var(--muted); text-decoration: none;">GitHub</a>
             </div>
           </div>
         </div>
       </footer>
     </div>
     <script is:inline>
       const select = document.getElementById('lang-select');
       function setLanguage(lang) {
         document.querySelectorAll('[data-' + lang + ']').forEach(el => {
           el.textContent = el.getAttribute('data-' + lang);
         });
         localStorage.setItem('preferred-lang', lang);
         select.value = lang;
       }
       select.addEventListener('change', (e) => {
         setLanguage(e.target.value);
       });
       // Initial load: Default to English as requested
       const savedLang = localStorage.getItem('preferred-lang') || 'en';
       setLanguage(savedLang);
     </script>
   </body>
</html>
