---
import { site } from '../data/site';
import '../styles/global.css';

const { title, description, pageClass = '' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const pathWithoutBase = Astro.url.pathname.replace(base.replace(/\/$/, ''), '') || '/';
const pathname = pathWithoutBase.length > 1 ? pathWithoutBase.replace(/\/$/, '') : pathWithoutBase;
const navigation = [
  { href: '/', es: 'Inicio', en: 'Home' },
  { href: '/historia-en-vivo', es: 'Historia en vivo', en: 'Live Build Story', featured: true },
  { href: '/proyectos', es: 'Proyectos', en: 'Projects' },
  { href: '/hackatones', es: 'Hackatones', en: 'Hackathons' },
  { href: '/ralphi-ia', es: 'Ralphi IA', en: 'Ralphi IA' },
  { href: '/contacto', es: 'Contacto', en: 'Contact' },
];
const hrefFor = (href) => href === '/' ? base : `${base}${href.slice(1)}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#08110f" />
    <meta name="color-scheme" content="dark" />
    <title>{title ? `${title} · ${site.brand}` : site.brand}</title>
    <meta name="description" content={description || site.tagline} />
    <meta property="og:title" content={title ? `${title} · ${site.brand}` : site.brand} />
    <meta property="og:description" content={description || site.tagline} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={`${base}favicon.svg`} />
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main-content" data-es="Saltar al contenido" data-en="Skip to content">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <div class="header-inner">
          <a class="brand-lockup" href={base} aria-label="InnerChispa home">
            <span class="brand-spark" aria-hidden="true"><i></i><i></i><i></i></span>
            <span><strong>InnerChispa</strong><small>Human intent · agent craft</small></span>
          </a>
          <nav class="main-nav" aria-label="Primary navigation">
            {navigation.map((item) => (
              <a
                href={hrefFor(item.href)}
                class:list={{ active: pathname === item.href, featured: item.featured }}
                aria-current={pathname === item.href ? 'page' : undefined}
                data-es={item.es}
                data-en={item.en}
              >{item.en}</a>
            ))}
          </nav>
          <label class="language-control">
            <span class="sr-only" data-es="Idioma" data-en="Language">Language</span>
            <select id="lang-select" aria-label="Language">
              <option value="en">EN</option>
              <option value="es">ES</option>
            </select>
          </label>
        </div>
      </header>
      <main id="main-content">
        <div class="page-frame">
          <slot />
        </div>
      </main>
      <footer class="site-footer">
        <div class="footer-inner">
          <div class="footer-statement">
            <span class="kicker">InnerChispa · 2026</span>
            <p data-en="Building useful systems in public—without making private work public." data-es="Construimos sistemas útiles en público—sin hacer público el trabajo privado.">
              Building useful systems in public—without making private work public.
            </p>
          </div>
          <div class="footer-links">
            <a href={`${base}privacy`} data-en="Privacy boundary" data-es="Límite de privacidad">Privacy boundary</a>
            <a href="https://github.com/Rafa-Innerchispa" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
            <a href={`mailto:${site.contact}`} data-en="Human contact" data-es="Contacto humano">Human contact</a>
          </div>
        </div>
      </footer>
    </div>
    <script is:inline>
      const languageSelect = document.getElementById('lang-select');
      const supportedLanguages = new Set(['en', 'es']);
      function applyLanguage(requested) {
        const language = supportedLanguages.has(requested) ? requested : 'en';
        document.documentElement.lang = language;
        document.querySelectorAll(`[data-${language}]`).forEach((element) => {
          element.textContent = element.getAttribute(`data-${language}`);
        });
        languageSelect.value = language;
        localStorage.setItem('preferred-lang', language);
        window.dispatchEvent(new CustomEvent('innerchispa:language', { detail: { language } }));
      }
      languageSelect.addEventListener('change', (event) => applyLanguage(event.target.value));
      applyLanguage(localStorage.getItem('preferred-lang') || 'en');
    </script>
  </body>
</html>
